# ============================================
# PERFORMANCE OPTIMIZED CONFIGURATION
# ============================================
# Copy settings ini ke .env untuk production
# atau development yang butuh kecepatan maksimal

# 1. DISABLE DEBUG MODE (sangat penting!)
APP_DEBUG=false
LOG_LEVEL=error

# 2. CACHE DRIVER - gunakan 'file' untuk performa lebih baik
# 'database' sangat lambat karena setiap cache hit = query database
CACHE_STORE=file

# 3. SESSION DRIVER - 'database' lebih baik untuk multi-server
# tapi 'file' lebih cepat untuk single server
SESSION_DRIVER=database

# 4. QUEUE - gunakan 'database' atau 'redis' untuk background jobs
QUEUE_CONNECTION=database

# 5. OPCACHE - pastikan PHP OPcache enabled di php.ini
# opcache.enable=1
# opcache.memory_consumption=256
# opcache.max_accelerated_files=20000
# opcache.validate_timestamps=0 (production only)

# 6. COMPOSER - jalankan: composer install --optimize-autoloader --no-dev

# 7. LARAVEL OPTIMIZE - jalankan setelah deploy:
# php artisan optimize
# php artisan config:cache
# php artisan route:cache
# php artisan view:cache
# php artisan filament:optimize

# 8. DATABASE CONNECTION POOLING
# Supabase sudah menggunakan connection pooler (pooler.supabase.com)
# Pastikan menggunakan pooler, bukan direct connection

# 9. ASSET OPTIMIZATION
# npm run build (untuk production)
# php artisan filament:optimize

# 10. GZIP COMPRESSION - enable di web server (nginx/apache)
